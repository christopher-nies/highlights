HL_POSTGRES_PASSWORD=change-me
READECK_URL=https://readeck.example.com
# Readeck → Settings → API tokens. Read-only scope is enough.
READECK_TOKEN=
# Optional: BookOrbit book highlights. Its annotation list shows only the logged-in user's own highlights,
# so these are the credentials of the reader whose highlights you collect. Leave empty to skip BookOrbit.
BOOKORBIT_URL=https://bookorbit.example.com
BOOKORBIT_USERNAME=
BOOKORBIT_PASSWORD=
INGEST_MINUTES=60
