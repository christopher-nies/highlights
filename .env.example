HL_POSTGRES_PASSWORD=change-me
READECK_URL=https://readeck.example.com
# Readeck → Settings → API tokens. Read-only scope is enough.
READECK_TOKEN=
# Optional: BookOrbit book highlights. Its annotation list shows only the logged-in user's own highlights,
# so these are the credentials of the reader whose highlights you collect. Leave empty to skip BookOrbit.
BOOKORBIT_URL=https://bookorbit.example.com
BOOKORBIT_USERNAME=
BOOKORBIT_PASSWORD=
# Optional, one-off: a Readwise backfill with `bun src/main.ts import-readwise` (token from readwise.io/access_token).
READWISE_TOKEN=
# Optional: Snipd podcast snips. The token is the one Snipd hands the official Obsidian plugin: open
# app.snipd.com/obsidian/auth?uuid=<any new uuid>, sign in, then GET api.snipd.com/v1/public/api/obsidian/auth?uuid=<same uuid>
# answers {"token": ...}. Leave empty to skip Snipd.
SNIPD_TOKEN=
INGEST_MINUTES=60
